# ─── Appwrite configuration ───────────────────────────────
# Copy this file to `.env` and fill in the values from your Appwrite console.

# Your Appwrite API endpoint (Cloud default shown)
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Project ID  (Appwrite Console → Project settings)
VITE_APPWRITE_PROJECT_ID=your_project_id

# Database ID (Appwrite Console → Databases)
VITE_APPWRITE_DB_ID=raidar

# Collection IDs
VITE_APPWRITE_PLANS_COLLECTION_ID=plans
VITE_APPWRITE_SUBSCRIPTIONS_COLLECTION_ID=subscriptions

# ─── Stripe (frontend) ────────────────────────────────────
# Publishable key is safe to expose in the browser. NEVER put the secret key here.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ID of the Appwrite Function that creates Stripe Checkout sessions
VITE_APPWRITE_CHECKOUT_FUNCTION_ID=stripe-checkout

# ID of the Appwrite Function that opens the Stripe billing portal
VITE_APPWRITE_PORTAL_FUNCTION_ID=stripe-portal

# ID of the admin-only user-management / stats Appwrite Function
VITE_APPWRITE_ADMIN_FUNCTION_ID=admin-api
